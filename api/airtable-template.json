      ]
    },
    {
      "name": "Publisher Blueprint Actions",
      "purpose": "Destination for exported plan rows from the Publisher Blueprint dashboard. Supports upsert by Key so re-exporting updates existing rows instead of duplicating them.",
      "default_table_name_in_code": "Publisher Blueprint Actions",
      "used_by_adapter": "airtable_records",
      "upsert_key": ["Key"],
      "export_scopes": ["saved", "roadmap", "recommendations", "kpis", "scores"],
      "fields": [
        {
          "name": "Key",
          "airtable_type": "singleLineText",
          "required": true,
          "primary": true,
          "description": "Stable identifier used for upsert. Format varies by source: saved:{id}, opportunity:{id}, quick-win:{id}, long-term:{id}, roadmap:{phaseId}:{index}, roadmap-metric:{phaseId}:{index}, kpi:{id}, score:{categoryId}, score:overall.",
          "sample_values": ["saved:rec_123", "opportunity:opp_001", "roadmap:phase_01:0", "score:overall"]
        },
        {
          "name": "Type",
          "airtable_type": "singleSelect",
          "required": true,
          "description": "The kind of row being exported.",
          "options": {
            "choices": [
              { "name": "Saved action", "color": "blueLight2" },
              { "name": "Opportunity", "color": "purpleLight2" },
              { "name": "Quick win", "color": "greenLight2" },
              { "name": "Long-term move", "color": "orangeLight2" },
              { "name": "Roadmap activity", "color": "cyanLight2" },
              { "name": "Roadmap metric", "color": "yellowLight2" },
              { "name": "KPI", "color": "pinkLight2" },
              { "name": "Score", "color": "grayLight2" }
            ]
          }
        },
        {
          "name": "Category",
          "airtable_type": "singleLineText",
          "required": false,
          "description": "Category label from the blueprint, recommendation category, or phase name.",
          "sample_values": ["Audience", "Content", "Distribution", "Operations", "Strategy", "Alignment", "Foundation", "Growth", "Measurement"]
        },
        {
          "name": "Title",
          "airtable_type": "singleLineText",
          "required": true,
          "description": "Short title of the action, opportunity, metric, or score.",
          "sample_values": ["Build a newsletter referral program", "Q1 content audit"]
        },
        {
          "name": "Detail",
          "airtable_type": "multilineText",
          "required": false,
          "description": "Full description, rationale, or additional context for the row.",
          "sample_values": ["Launch a double-sided referral program to grow owned audience."]
        },
        {
          "name": "Impact",
          "airtable_type": "singleSelect",
          "required": false,
          "description": "Expected impact of the action. For KPIs and metrics this is set to Measure or Track.",
          "options": {
            "choices": [
              { "name": "High", "color": "greenLight2" },
              { "name": "Medium", "color": "yellowLight2" },
              { "name": "Low", "color": "redLight2" },
              { "name": "Track", "color": "blueLight2" },
              { "name": "Measure", "color": "purpleLight2" }
            ]
          }
        },
        {
          "name": "Effort",
          "airtable_type": "singleSelect",
          "required": false,
          "description": "Estimated effort to complete the action.",
          "options": {
            "choices": [
              { "name": "High", "color": "redLight2" },
              { "name": "Medium", "color": "yellowLight2" },
              { "name": "Low", "color": "greenLight2" }
            ]
          }
        },
        {
          "name": "Phase",
          "airtable_type": "singleLineText",
          "required": false,
          "description": "Priority rank, roadmap month, or KPI target. Format varies by source: Priority N, Month N, Target: value.",
          "sample_values": ["Priority 1", "Month 1", "Target: 10% list growth"]
        },
        {
          "name": "Owner",
          "airtable_type": "singleLineText",
          "required": false,
          "description": "Person or team assigned to the action. Empty until the user assigns it in Airtable.",
          "sample_values": ["Content Lead", "Growth Team"]
        },
        {
          "name": "Status",
          "airtable_type": "singleSelect",
          "required": false,
          "description": "Current status of the row. Exported actions default to To do; metrics default to Measure; KPIs default to Track.",
          "options": {
            "choices": [
              { "name": "To do", "color": "grayLight2" },
              { "name": "Done", "color": "greenLight2" },
              { "name": "Measure", "color": "purpleLight2" },
              { "name": "Track", "color": "blueLight2" },
              { "name": "Strength", "color": "greenLight2" }
            ]
          }
        },
        {
          "name": "Source",
          "airtable_type": "singleLineText",
          "required": false,
          "description": "Origin of the recommendation. Publisher Blueprint for engine-generated items, Publisher Copilot for AI-generated saved actions.",
          "sample_values": ["Publisher Blueprint", "Publisher Copilot"]
        },
        {
          "name": "Created",
          "airtable_type": "date",
          "required": false,
          "description": "ISO 8601 date string when the row was created. Stored as YYYY-MM-DD.",
          "date_format": "YYYY-MM-DD"
        }
      ],
      "sample_records": [
