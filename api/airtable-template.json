{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://publisher-blueprint.com/api/airtable-template.json",
  "title": "Publisher Blueprint™ Airtable Template",
  "description": "Schema and sample data for the two Airtable tables used by Publisher Blueprint™: lifecycle CRM contacts and exported action plans. Field names are case-sensitive and must match exactly so the Airtable integration adapters can write to them.",
  "version": "1.0.0",
  "product": "Publisher Blueprint™",
  "company": "Momentive Ventures LLC",
  "generated_at": "2026-08-03",
  "source_code": {
    "contacts_adapter": "src/lib/integrations/airtable.server.ts",
    "records_adapter": "src/lib/integrations/airtable-records.server.ts",
    "export_rows": "src/lib/export/rows.ts",
    "types": "src/lib/integrations/types.ts"
  },
  "tables": [
    {
      "name": "Publisher Blueprint Contacts",
      "purpose": "Destination for lifecycle and qualification events sent by the platform outbox. Each row is a normalized event for a user or organization.",
      "default_table_name_in_code": "Publisher Blueprint Contacts",
      "used_by_adapter": "airtable",
      "event_names": [
        "user.signed_up",
        "assessment.completed",
        "purchase.completed",
        "subscription.changed",
        "lifecycle.stage_changed",
        "qualification.tier_changed",
        "organization.updated"
      ],
      "fields": [
        {
          "name": "Name",
          "airtable_type": "singleLineText",
          "required": false,
          "description": "Full name from the user profile. Maps to IntegrationEvent.fullName.",
          "sample_values": ["Jeff Hallstead", "Alex Rivera", "Sample Org Admin"]
        },
        {
          "name": "Email",
          "airtable_type": "email",
          "required": false,
          "description": "User email address. Maps to IntegrationEvent.email.",
          "sample_values": ["jeff@example.com", "alex@example.com"]
        },
        {
          "name": "Event",
          "airtable_type": "singleSelect",
          "required": true,
          "description": "The canonical event name. Maps to IntegrationEvent.eventName.",
          "options": {
            "choices": [
              { "name": "user.signed_up", "color": "blueLight2" },
              { "name": "assessment.completed", "color": "greenLight2" },
              { "name": "purchase.completed", "color": "purpleLight2" },
              { "name": "subscription.changed", "color": "orangeLight2" },
              { "name": "lifecycle.stage_changed", "color": "cyanLight2" },
              { "name": "qualification.tier_changed", "color": "yellowLight2" },
              { "name": "organization.updated", "color": "grayLight2" }
            ]
          }
        },
        {
          "name": "Occurred At",
          "airtable_type": "dateTime",
          "required": true,
          "description": "ISO 8601 timestamp of the event. Maps to IntegrationEvent.occurredAt.",
          "date_format": "ISO",
          "time_zone": "UTC",
          "include_time": true
        },
        {
          "name": "Organization",
          "airtable_type": "singleLineText",
          "required": false,
          "description": "Organization name when available. Maps to IntegrationEvent.organization.",
          "sample_values": ["Momentive Ventures", "Acme Publishing", "One Sweet Dream"]
        },
        {
          "name": "Publisher Index",
          "airtable_type": "number",
          "required": false,
          "description": "0-100 overall assessment score. Maps to IntegrationEvent.score.",
          "precision": 0,
          "validation": { "min": 0, "max": 100 }
        },
        {
          "name": "Maturity Level",
          "airtable_type": "singleLineText",
          "required": false,
          "description": "Human-readable maturity title from the assessment. Maps to IntegrationEvent.maturityLevel.",
          "sample_values": ["Observer", "Contributor", "Publisher", "Platform", "Monetizer"]
        },
        {
          "name": "Tier",
          "airtable_type": "singleLineText",
          "required": false,
          "description": "Entitlement or qualification tier. Maps to IntegrationEvent.tier.",
          "sample_values": ["free", "blueprint", "os", "lead", "marketing_qualified", "sales_qualified", "customer"]
        },
        {
          "name": "Amount",
          "airtable_type": "currency",
          "required": false,
          "description": "Purchase or subscription amount in cents is converted to dollars by the app. Maps to IntegrationEvent.amount.",
          "precision": 2,
          "symbol": "$"
        },
        {
          "name": "Currency",
          "airtable_type": "singleLineText",
          "required": false,
          "description": "ISO 4217 currency code. Maps to IntegrationEvent.currency.",
          "sample_values": ["USD"]
        }
      ],
      "sample_records": [
        {
          "Name": "Jeff Hallstead",
          "Email": "jeff@example.com",
          "Event": "user.signed_up",
          "Occurred At": "2026-08-01T14:30:00.000Z",
